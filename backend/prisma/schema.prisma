// Prisma Schema for Inventory Management System
// Database: PostgreSQL
// Primary Keys: UUID v4
// Money Precision: Decimal(12, 2)
// Timestamps: UTC (handled natively by Prisma DateTime)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User Roles in the system
enum Role {
  ADMIN
  USER
}

/// Inventory Transaction Type (Stock Movement)
enum TransactionType {
  IN
  OUT
}

/// User entity for Authentication & Role-Based Access Control (RBAC)
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

/// Supplier entity representing product vendors/suppliers
model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("suppliers")
}

/// Product Category entity
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

/// Product entity (Soft delete supported via `deletedAt`)
/// Note: Product status (e.g., IN_STOCK, LOW_STOCK, OUT_OF_STOCK) is NOT stored in the database.
/// It must be computed dynamically in backend services or SQL views:
/// - OUT_OF_STOCK: quantity <= 0
/// - LOW_STOCK: 0 < quantity <= lowStockThreshold
/// - IN_STOCK: quantity > lowStockThreshold
model Product {
  id                String                 @id @default(uuid()) @db.Uuid
  productName       String                 @map("product_name")
  sku               String                 @unique
  description       String?
  imageUrl          String?                @map("image_url")
  quantity          Int                    @default(0)
  lowStockThreshold Int                    @default(10) @map("low_stock_threshold")
  unitPrice         Decimal                @map("unit_price") @db.Decimal(12, 2)
  supplierId        String                 @map("supplier_id") @db.Uuid
  categoryId        String                 @map("category_id") @db.Uuid
  deletedAt         DateTime?              @map("deleted_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  supplier          Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions      InventoryTransaction[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([productName])
  @@index([categoryId, deletedAt])
  @@index([supplierId, deletedAt])
  @@map("products")
}

/// Inventory Transaction entity for auditing stock inward/outward movements
model InventoryTransaction {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  type      TransactionType
  quantity  Int
  remarks   String?
  createdAt DateTime        @default(now()) @map("created_at")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_transactions")
}
