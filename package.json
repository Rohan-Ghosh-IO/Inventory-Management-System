{
  "name": "inventory-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-inspired Inventory Management System Monorepo",
  "workspaces": [
    "backend/shared",
    "backend/auth-service",
    "backend/inventory-service",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:seed": "ts-node backend/prisma/seed.ts",
    "dev": "concurrently --names \"AUTH,INVENTORY,FRONTEND\" -c \"cyan,yellow,green\" \"npm run dev:auth\" \"npm run dev:inventory\" \"npm run dev:frontend\"",
    "dev:auth": "npm --workspace=backend/auth-service run dev",
    "dev:inventory": "npm --workspace=backend/inventory-service run dev",
    "dev:frontend": "npm --workspace=frontend run dev"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "8.2.2",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  }
}
